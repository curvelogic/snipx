{
  "name": "@curvelogic/snipx",
  "version": "0.1.0",
  "description": "TypeScript implementation of snipx: parse, expand, resolve, and export canonical JSON",
  "license": "MIT OR Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:conformance": "vitest run tests/conformance.test.ts"
  },
  "dependencies": {
    "commonmark": "^0.31.2"
  },
  "devDependencies": {
    "@types/commonmark": "^0.27.9",
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0",
    "vitest": "^3.2.6"
  },
  "packageManager": "pnpm@8.14.1"
}
